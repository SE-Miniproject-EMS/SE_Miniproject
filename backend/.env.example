# Copy this file to .env and fill in real values. Never commit the real .env file.

# SQLite file for local dev (created automatically on first run).
# For a shared/staging environment, switch src/config/db.js to Postgres/MySQL
# (per the SAD) instead of this file-based setting.
DATABASE_FILE="./dev.db"

# Use a long, random string in real environments (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="1d"
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Used to sign the (stubbed) email-verification token
EMAIL_VERIFICATION_SECRET="replace_this_with_another_long_random_secret"

PORT=5000
CORS_ORIGIN="http://localhost:5173"

# Notifications: console is a development/test delivery adapter only.
# Configure a real provider adapter before production deployment.
NOTIFICATION_ADAPTER=console

# Mock-only paid checkout reservation settings; no payment provider is configured.
PAYMENT_RESERVATION_TTL_MINUTES=10
PAYMENT_EXPIRY_SCAN_INTERVAL_MS=30000

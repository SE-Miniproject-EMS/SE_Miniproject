digraph architecture {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=21, labelloc=t,
         label="EMS AS-BUILT COMPONENT VIEW — CURRENT CODE BASELINE (29 OCT 2026)"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#375a7f", penwidth=1.2, margin="0.15,0.1"];
  edge [fontname="Arial", fontsize=9, color="#536273", arrowsize=0.75];

  browser [label="Browser\nReact 18 + Vite SPA\nPages, AuthContext, Axios API client", fillcolor="#e9f2ff"];
  api [label="Express application\n/api/health · /api/auth · /api/events · /api/example\nJSON parsing · CORS · error handlers", fillcolor="#f0f4fb"];
  {rank=same; auth; events; middleware;}
  auth [label="Auth route + controller\nregister · verify email · login · current user", fillcolor="#e4f5e9"];
  events [label="Event route + controller\ncreate · list/search · details · edit · publish · cancel", fillcolor="#e4f5e9"];
  middleware [label="Auth middleware\nJWT authenticate · role authorize", fillcolor="#fff2d8"];
  data [label="Sequelize data layer\nUser and Event models\nUser 1 → many Events", fillcolor="#f0f4fb"];
  sqlite [shape=cylinder, label="SQLite database file\nDATABASE_FILE (default ./dev.db)", fillcolor="#f4eaff", color="#74509c"];
  ci [label="GitHub Actions CI (separate from runtime)\nNode 24 · backend npm test · frontend npm run build", fillcolor="#f5f5f5", color="#6b7280"];
  future [label="Planned modules — not present\nregistration/waitlist · payment · email/SMS notifications\nQR/check-in · dashboards/reports · feedback", fillcolor="#fff7dc", color="#aa8b31"];

  browser -> api [label="HTTP JSON in local dev\nVITE_API_URL (default localhost:5000/api)"];
  api -> auth [label="/api/auth"];
  api -> events [label="/api/events"];
  api -> middleware [label="protected routes"];
  auth -> middleware [dir=both, label="JWT / role checks", constraint=false];
  events -> middleware [dir=both, label="JWT / role checks", constraint=false];
  auth -> data;
  events -> data;
  middleware -> data [style=dashed, label="identity/roles from token"];
  data -> sqlite [label="SQLite persistence"];
  ci -> api [style=dashed, arrowhead=none, label="validates code/tests/build"];
  future -> api [style=dashed, arrowhead=none, label="backlog, not implemented"];
}
